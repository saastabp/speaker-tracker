        <mxCell id="p2-note-mid" value="&lt;b&gt;SES rewrites the Message-ID.&lt;/b&gt;&lt;br&gt;The header the recipient sees is not the one&lt;br&gt;we mint, so the id returned by SendRawEmail&lt;br&gt;is stored as external_message_id — that is&lt;br&gt;what inbound In-Reply-To / References match.&lt;br&gt;Without it, replies chain against an id that&lt;br&gt;never left the building and are dropped." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;fillColor=#FFFFFF;strokeColor=#DD344C;" vertex="1" parent="p2-1">
          <mxGeometry x="1980" y="215" width="390" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p2-note-in" value="&lt;b&gt;Folder move is the idempotency mechanism.&lt;/b&gt;&lt;br&gt;A message is processed exactly once because the&lt;br&gt;poller moves it out of Import. Two pollers on one&lt;br&gt;mailbox would race and split inbound mail across&lt;br&gt;two databases — hence pollEnabled on exactly&lt;br&gt;one environment." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;fillColor=#FFFFFF;strokeColor=#8C4FFF;" vertex="1" parent="p2-1">
          <mxGeometry x="1500" y="960" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p2-e1" value="① SendRawEmail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2-1" source="p2-lapi" target="p2-ses">
